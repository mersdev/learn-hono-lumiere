{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumiere-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://lumiere-bpk.pages.dev",
    "CORS_ORIGIN": "https://lumiere-bpk.pages.dev",
    "BETTER_AUTH_URL": "https://lumiere-api.p22014454.workers.dev/api/auth",
    "EMAIL_FROM": "lumiere.csproject@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumiere-db",
      "database_id": "eae92745-8c51-42eb-bdd5-af055ada0710"
    }
  ]
  
  
}
